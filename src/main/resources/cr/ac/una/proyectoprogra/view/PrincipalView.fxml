<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="890.0" prefWidth="1512.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.proyectoprogra.controller.PrincipalController">
   <center>
      <VBox fx:id="mainDisplay" prefHeight="200.0" prefWidth="100.0" styleClass="mainDisplay" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin></VBox>
   </center>
   <top>
      <VBox prefHeight="98.0" prefWidth="1446.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_RIGHT" prefHeight="26.0" prefWidth="100.0" spacing="30.0" styleClass="hboxPrincipalHeader">
               <children>
                  <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="46.0" prefWidth="1122.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="btnPrimeFases" mnemonicParsing="false" onAction="#btnOnActionPrimeFases" styleClass="btnNS" text="%menu.primefase">
                           <HBox.margin>
                              <Insets left="30.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <Button fx:id="btnEspanol" mnemonicParsing="false" onAction="#btnOnActionEspanol" prefHeight="27.0" prefWidth="141.0" styleClass="btnIdioma" text="%menu.espanol">
                     <graphic>
                        <ImageView fitHeight="19.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resource/espa.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnIngles" mnemonicParsing="false" onAction="#btnOnActionIngles" prefHeight="27.0" prefWidth="143.0" styleClass="btnIdioma" text="%menu.ingles">
                     <graphic>
                        <ImageView fitHeight="21.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resource/ing.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#btnOnActionCerrarSesion" prefHeight="30.0" prefWidth="170.0" styleClass="btnIdioma" text="Cerrar sesion">
                     <graphic>
                        <ImageView fitHeight="32.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resource/iconos_sicobu/iniciar_sesion.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="1394.0" styleClass="hboxMenu">
               <children>
                  <ImageView fx:id="imgBufete" fitHeight="32.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
                     <HBox.margin>
                        <Insets left="10.0" right="10.0" />
                     </HBox.margin></ImageView>
                  <Label fx:id="txtNombreBufete" prefHeight="36.0" prefWidth="354.0" styleClass="tituloMenu" text="Bufete">
                     <HBox.margin>
                        <Insets right="30.0" />
                     </HBox.margin></Label>
                  <HBox alignment="CENTER" prefHeight="38.0" prefWidth="863.0" spacing="20.0">
                     <children>
                        <Button fx:id="btnIndicadores" mnemonicParsing="false" onAction="#btnOnActionIndicadores" styleClass="btnMenu" text="%menu.indicadores" />
                        <Button fx:id="btnMantenimientos" mnemonicParsing="false" onAction="#btnOnActionMantenimientos" prefHeight="26.0" prefWidth="176.0" styleClass="btnMenu" text="%menu.mantenimientos">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../resource/iconos_sicobu/flecha_abajo_normal.png" />
                                 </image>
                              </ImageView>
                           </graphic></Button>
                        <Button fx:id="btnInstrumentos" mnemonicParsing="false" onAction="#btnOnActionInstrumentos" prefHeight="26.0" prefWidth="147.0" styleClass="btnMenu" text="%menu.instrumentos">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../resource/iconos_sicobu/flecha_abajo_normal.png" />
                                 </image>
                              </ImageView>
                           </graphic></Button>
                        <Button mnemonicParsing="false" onAction="#btnOnActionAgenda" prefHeight="26.0" prefWidth="134.0" styleClass="btnMenu" text="%menu.agenda" />
                        <Button mnemonicParsing="false" onAction="#btnOnActionContable" prefHeight="26.0" prefWidth="132.0" styleClass="btnMenu" text="%menu.contable" />
                        <Button mnemonicParsing="false" onAction="#btnOnActionReportes" prefHeight="26.0" prefWidth="112.0" styleClass="btnMenu" text="%menu.reportes" />
                     </children>
                  </HBox>
                  <ImageView fx:id="imgUsuario" fitHeight="38.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                     <image>
                        <Image url="@../resource/iconos_sicobu/usuarios.png" />
                     </image></ImageView>
                  <Label fx:id="txtNombreUsuario" prefHeight="36.0" prefWidth="174.0" styleClass="tituloMenu" text="Usuario">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin></Label>
               </children>
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </top>
</BorderPane>
