                                    <Image url="@../resource/iconos_sicobu/abogados_hover.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                           <children>
                              <Label styleClass="lblSubModal" text="%conta.modal.sub" />
