                        </VBox>
                        <VBox maxWidth="Infinity" prefWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="lblCampo" text="%contable.factura" />
                              <TextField fx:id="txtFactura" styleClass="txtCampo" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox prefHeight="80.0" prefWidth="518.0" spacing="6.0">
                     <children>
                        <Label styleClass="lblCampo" text="%contable.detalle" />
                        <TextField fx:id="txtDetalle" styleClass="txtCampo" />
                     </children>
                  </VBox>
                  <VBox prefHeight="70.0" prefWidth="514.0" spacing="6.0">
