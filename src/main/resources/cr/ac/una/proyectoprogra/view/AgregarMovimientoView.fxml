                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="79.0" prefWidth="518.0" spacing="16.0">
                     <children>
                        <VBox maxWidth="Infinity" prefWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="lblCampo" text="%contable.monto" />
                              <TextField fx:id="txtMonto" styleClass="txtCampo" />
