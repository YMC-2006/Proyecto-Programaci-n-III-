            </VBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="112.0" prefWidth="566.0" spacing="10.0" styleClass="modalFooter">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onActionBtnCancelar" styleClass="btnSecundario" text="%btn.cancelar">
                     <graphic>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                           <styleClass>
                              <String fx:value="btnImg" />
                              <String fx:value="cancelar" />
                           </styleClass>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#onActionBtnAgregar" styleClass="btnPrimario" text="%btn.agregar">
