                        <VBox maxWidth="Infinity" prefHeight="66.0" prefWidth="144.0" spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="lblCampo" text="%contable.tipo" />
                              <ComboBox fx:id="cbxTipo" prefHeight="38.0" prefWidth="247.0" styleClass="txtCampo" />
                           </children>
                        </VBox>
                        <VBox maxWidth="Infinity" prefHeight="66.0" prefWidth="30.0" spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="lblCampo" text="%contable.fecha" />
