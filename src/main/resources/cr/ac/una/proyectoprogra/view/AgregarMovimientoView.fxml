                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <VBox prefHeight="358.0" prefWidth="566.0" spacing="14.0" styleClass="vboxModal" VBox.vgrow="ALWAYS">
